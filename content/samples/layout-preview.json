  "sections": [
    {
      "id": "number-systems",
      "title": "Bases and notation",
      "blocks": [
        {
          "id": "binary-definition",
          "type": "definition",
          "term": "Binary",
          "text": "A base-2 number system using the digits 0 and 1.",
          "hint": "binary：二进制"
        },
        {
          "id": "binary-hardware",
          "type": "answer-points",
          "title": "Explain why computers use binary.",
          "items": [
            "Computers contain logic gates made from transistors that act as switches.",
            "These switches have two states, on and off, represented by the binary digits 1 and 0."
          ]
        },
        {
          "id": "bases-comparison",
          "type": "comparison",
          "title": "Three common number systems",
          "columns": [
            "System",
            "Base",
            "Digits used",
            "Example"
          ],
          "rows": [
            [
              "Denary",
              "10",
              "0–9",
              "45"
            ],
            [
              "Binary",
              "2",
              "0 and 1",
              "0010 1101"
            ],
            [
              "Hexadecimal",
              "16",
              "0–9 and A–F",
              "2D"
            ]
          ]
        },
        {
          "id": "hex-purpose",
          "type": "answer-points",
          "title": "Why prefer hexadecimal?",
          "hint": "4 bits ↔ 1 hex digit",
          "items": [
            "One hexadecimal digit represents four binary bits.",
            "Fewer digits make values easier to read, check and copy."
          ]
        }
      ]
    },
    {
      "id": "converting-values",
      "title": "Converting between representations",
      "blocks": [
        {
          "id": "binary-place-values",
          "type": "comparison",
          "title": "An 8-bit place-value table",
          "columns": [
            "128",
            "64",
            "32",
            "16",
            "8",
            "4",
            "2",
            "1"
          ],
          "rows": [
            [
              "0",
              "0",
              "1",
              "0",
              "1",
              "1",
              "0",
              "1"
            ]
          ],
          "hint": "只加数字为 1 的位权"
        },
        {
          "id": "binary-worked-example",
          "type": "example",
          "title": "Convert binary to denary.",
          "problem": "0010 1101₂ → denary.",
          "steps": [
            "Select the weights: 32, 8, 4, 1.",
            "32 + 8 + 4 + 1 = 45."
          ],
          "result": "45₁₀"
        },
        {
          "id": "hex-method",
          "type": "steps",
          "title": "Convert binary to hexadecimal.",
          "items": [
            "Group from the right: 0010 | 1101.",
            "Convert each group: 0010 → 2; 1101 → D.",
            "Answer: 2D₁₆."
          ]
        },
        {
          "id": "equivalent-values",
          "type": "equivalence",
          "title": "One value, three representations",
          "values": [
            {
              "label": "Denary",
              "value": "45"
            },
            {
              "label": "Binary (8-bit)",
              "value": "0010 1101"
            },
            {
              "label": "Hexadecimal",
              "value": "2D"
            }
          ]
        }
      ]
    },
    {
      "id": "overflow",
      "title": "Overflow in an unsigned 8-bit value",
      "blocks": [
        {
          "id": "overflow-definition",
          "type": "definition",
          "term": "Overflow",
          "text": "The result exceeds the range that the available bits can represent.",
          "hint": "overflow：溢出"
        },
        {
          "id": "overflow-worked-example",
          "type": "example",
          "title": "Add two 8-bit binary values.",
          "problem": "11001000₂ + 01100100₂",
          "steps": [
            "The binary sum is 1 0010 1100, requiring 9 bits.",
            "Stored low 8 bits: 00101100₂ = 44."
          ],
          "result": "300₁₀: overflow in 8 bits."
        },
        {
          "id": "overflow-explanation",
          "type": "answer-points",
          "title": "Explain why overflow occurs.",
          "hint": "指出结果、范围与容量限制",
          "items": [
            "The sum is 300; the maximum unsigned 8-bit value is 255.",
            "The correct result needs 9 bits, exceeding the register’s capacity."
          ]
        }
      ]
    }
  ],
