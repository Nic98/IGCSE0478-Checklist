{
  "name": "igcse-0478-checklists",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/prepare-pdfs.mjs --sample && astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --sample",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/build.mjs --sample && node scripts/build.mjs && playwright test"
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
