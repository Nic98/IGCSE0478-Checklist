---
import '../styles/global.css';
import { sitePath } from '../lib/site';
interface Props { title: string; sample?: boolean; }
const { title, sample = false } = Astro.props;
// Resolve public fonts against the project path in development and production.
const fontFaces = [
  ['Source Sans', 'SourceSans3-Regular', '400'],
  ['Source Sans', 'SourceSans3-Semibold', '600 800'],
  ['Source Serif', 'SourceSerif4-Regular', '400'],
  ['Source Serif', 'SourceSerif4-Semibold', '600 800'],
  ['Noto Sans SC', 'NotoSansSC-Regular', '400 700'],
].map(([family, file, weight]) =>
  `@font-face{font-family:"${family}";src:url("${sitePath(`fonts/${file}.woff2`)}") format("woff2");font-weight:${weight};font-display:swap}`
).join('\n');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline set:html={fontFaces} />
    <title>{title} · IGCSE Computer Science 0478</title>
    <meta name="description" content="Chapter-by-chapter exam revision for IGCSE Computer Science 0478, with concise answer points and essential calculations." />
    {sample && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header screen-only">
      <a href={sitePath()} class="brand" aria-label="Computer Science 0478 course index">
        <span class="brand-mark" aria-hidden="true">0478<span></span></span>
        <span class="brand-name">Computer Science<span>IGCSE LEARNING CHECKLISTS</span></span>
      </a>
      <span class="syllabus-tag">SYLLABUS <strong>2026–2028</strong></span>
    </header>
    <slot />
    <footer class="site-footer screen-only">
      <span>IGCSE Computer Science <strong>0478</strong></span>
      <span>Independent teaching resource · 2026–2028</span>
    </footer>
  </body>
</html>
