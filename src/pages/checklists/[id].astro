---
import Base from '../../layouts/Base.astro';
import KnowledgeBlock from '../../components/KnowledgeBlock.astro';
import { availableDocuments } from '../../../lib/content.mjs';
import { localPreview, sitePath, type Checklist } from '../../lib/site';
import '../../styles/knowledge.css';

export function getStaticPaths() {
  return availableDocuments(localPreview).map((document: Checklist) => ({ params: { id: document.id }, props: { document } }));
}
interface Props { document: Checklist; }
const { document } = Astro.props;
const reviewTopics = document.reviewTopics ?? [];
const ratings = [
  { value: 'not-yet', label: 'Not yet' },
  { value: 'developing', label: 'Developing' },
  { value: 'confident', label: 'Confident' },
];
---
<Base title={document.title} sample={document.sample}>
  <main id="main" class="summary-main" data-checklist-id={document.id}>
    <a class="back-link screen-only" href={sitePath()}><span aria-hidden="true">←</span><span>Course index</span></a>
    {document.sample && <aside class="sample-banner"><span class="sample-badge">LAYOUT PREVIEW</span><p>A selection of knowledge points for layout review. This is not a complete chapter.<span lang="zh-Hans">知识点汇总排版示例；正式章节的范围和内容另行确认。</span></p></aside>}
    <header class="summary-heading">
      <p class="eyebrow">{document.sample ? 'SAMPLE' : `CHECKLIST ${document.label}`}<span class="eyebrow-divider">/</span>KNOWLEDGE SUMMARY</p>
      <h1>{document.title}</h1>
      {document.subtitle && <p class="summary-subtitle">{document.subtitle}</p>}
      <div class="summary-meta"><span>0478 · {document.syllabus}</span><span>{document.sections.length} topics</span><span>Version {document.version}</span></div>
    </header>
    <div class="summary-toolbar screen-only">
      <p>Definitions, methods and key explanations.</p>
      <div class="tool-actions"><button id="print-button" class="button secondary" type="button" hidden><svg aria-hidden="true" viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 7V2h10v5M5 14H2V7h16v7h-3M5 11h10v7H5z"/></svg>Print</button><a class="button primary" href={sitePath(`pdfs/${document.id}.pdf`)} download><svg aria-hidden="true" viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M10 2v10m-4-4 4 4 4-4M3 12v5h14v-5"/></svg>Download PDF<span class="button-detail">A4</span></a></div>
    </div>
    <div class="summary-layout">
      <nav class="topic-nav screen-only" aria-label="On this page"><p class="small-label">ON THIS PAGE</p><ol>{document.sections.map((section, index) => <li><a href={`#section-${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.title}</a></li>)}</ol><p class="nav-footnote">Read the explanation.<br />Follow the method.<br />Check the reasoning.</p></nav>
      <article class="knowledge-content" aria-label={`${document.title} knowledge summary`}>
        {document.sections.map((section, index) => <section class="knowledge-section" aria-labelledby={`section-${section.id}`}>
          <header class="knowledge-section-heading"><span class="section-number">{String(index + 1).padStart(2, '0')}</span><div><h2 id={`section-${section.id}`}>{section.title}</h2>{section.summary && <p>{section.summary}</p>}</div></header>
          {section.blocks.map((block) => <KnowledgeBlock block={block} />)}
        </section>)}
        {reviewTopics.length > 0 && <details class="optional-assessment" id="optional-assessment"><summary><span>Review notes <small>Optional self-assessment</small></span><span class="details-indicator" aria-hidden="true">+</span></summary><div class="assessment-content"><p class="assessment-intro screen-only">Mark a topic to revisit. Your choices stay in this browser.</p><p id="storage-warning" class="storage-warning screen-only" role="status" hidden></p><noscript><p class="storage-warning">Automatic saving requires JavaScript. The knowledge summary and PDF remain available.</p></noscript><table class="review-table"><thead><tr><th scope="col">Topic</th>{ratings.map((rating) => <th scope="col">{rating.label}</th>)}</tr></thead><tbody>{reviewTopics.map((topic) => <tr><th scope="row">{topic.label}</th>{ratings.map((rating) => <td><label class="rating-choice"><input type="radio" name={`assessment-${topic.id}`} value={rating.value} data-progress-item={topic.id} aria-label={`${topic.label} — ${rating.label}`} /><span class="choice-display" aria-hidden="true"></span><span class="mobile-rating-label" aria-hidden="true">{rating.label}</span></label></td>)}</tr>)}</tbody></table></div></details>}
        <div class="checklist-end"><span>END OF {document.sample ? 'SAMPLE' : 'SUMMARY'}</span><span>0478 / {document.label} / v{document.version}</span></div>
      </article>
    </div>
  </main>
</Base>
<script>
  import { readProgress, saveProgress } from '../../../lib/progress.mjs';
  const main = document.querySelector<HTMLElement>('[data-checklist-id]');
  const printButton = document.querySelector<HTMLButtonElement>('#print-button');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
  const review = document.querySelector<HTMLDetailsElement>('#optional-assessment');
  if (main?.dataset.checklistId && review) {
    const id = main.dataset.checklistId;
    const inputs = Array.from(review.querySelectorAll<HTMLInputElement>('input[data-progress-item]'));
    const itemIds = [...new Set(inputs.map((input) => input.dataset.progressItem!))];
    const warning = document.querySelector<HTMLElement>('#storage-warning')!;
    let state: Record<string, string> = {};
    const showWarning = (message: string) => { warning.textContent = message; warning.hidden = false; };
    const updatePrintState = () => { review.toggleAttribute('data-has-assessment', inputs.some((input) => input.checked)); };
    try {
      state = readProgress(window.localStorage, id, itemIds);
      inputs.forEach((input) => { input.checked = state[input.dataset.progressItem!] === input.value; });
    } catch {
      showWarning('Saved choices could not be read. You can still review on this page. 当前浏览器无法读取已保存的自评。');
    }
    updatePrintState();
    review.addEventListener('change', (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || !input.dataset.progressItem) return;
      state[input.dataset.progressItem] = input.value;
      updatePrintState();
      try {
        saveProgress(window.localStorage, id, state);
        warning.hidden = true;
      } catch {
        showWarning('Your choices cannot be saved in this browser. They will be lost when you leave or reload. 自评暂时无法保存，离开或刷新后将丢失。');
      }
    });
    let reviewWasOpen = false;
    window.addEventListener('beforeprint', () => {
      reviewWasOpen = review.open;
      review.open = review.hasAttribute('data-has-assessment');
    });
    window.addEventListener('afterprint', () => { review.open = reviewWasOpen; });
  }
</script>
