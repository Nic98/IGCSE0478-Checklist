---
import Base from '../layouts/Base.astro';
import Lock from '../components/Lock.astro';
import { catalog, validateReleases, releaseIds, availableDocuments } from '../../lib/content.mjs';
import { localPreview, sitePath } from '../lib/site';
const published = new Set(validateReleases(releaseIds));
const selectedReview = localPreview ? availableDocuments(true).find((document) => document.id.startsWith('local-review-')) : undefined;
const papers = [
  { id: 1, name: 'Computer systems', description: 'Data, hardware and the connected world', chapters: catalog.filter((chapter: any) => chapter.paper === 1) },
  { id: 2, name: 'Algorithms, programming and logic', description: 'From problem-solving to working solutions', chapters: catalog.filter((chapter: any) => chapter.paper === 2) },
];
---
<Base title="Course index">
  <main id="main" class="course-main">
    <div class="course-intro">
      <div><p class="eyebrow">COMPUTER SCIENCE · EXAM REVISION</p><h1>One topic at a time.</h1><p class="intro-text">Key answer points. Essential working.<br />Your chapter-by-chapter checklist before the exam.</p></div>
      <div class="course-meta"><span class="meta-number">10</span><span>chapters<br />one clear path</span></div>
    </div>
    <div class="course-toolbar">
      <div><span class="small-label">COURSE INDEX</span><span class="release-count">{published.size ? `${published.size} checklists available` : 'Checklists will open as your course progresses.'}</span></div>
      <span class="locked-legend"><Lock /> Not yet available</span>
    </div>
    <div class="course-layout">
      <nav class="chapter-nav" aria-label="Course chapters">
        <p class="small-label">CONTENTS</p>
        {papers.map((paper) => <div class="nav-group"><p>Paper {paper.id}</p>{paper.chapters.map((chapter: any) => <a href={`#chapter-${chapter.id}`}><span>{chapter.id.padStart(2, '0')}</span>{chapter.title}</a>)}</div>)}
        {localPreview && <a class="preview-nav" href={sitePath('checklists/layout-preview/')}><span class="preview-dot"></span>Layout preview <span aria-hidden="true">↗</span></a>}
        {selectedReview && <a class="preview-nav" href={sitePath(`checklists/${selectedReview.id}/`)}><span class="preview-dot"></span>Local review · {selectedReview.label}<span aria-hidden="true">↗</span></a>}
      </nav>
      <div class="chapter-list">
        {papers.map((paper) => <section class="paper-section" aria-labelledby={`paper-${paper.id}`}>
          <div class="paper-heading"><span class="paper-label">PAPER {paper.id}</span><div><h2 id={`paper-${paper.id}`}>{paper.name}</h2><p>{paper.description}</p></div></div>
          {paper.chapters.map((chapter: any) => <section class="chapter" id={`chapter-${chapter.id}`} aria-labelledby={`chapter-title-${chapter.id}`}>
            <header class="chapter-heading"><span class="chapter-number">{chapter.id.padStart(2, '0')}</span><h3 id={`chapter-title-${chapter.id}`}>{chapter.title}</h3>{chapter.units.length > 0 && <span class="chapter-total">{chapter.units.length} checklists</span>}</header>
            {chapter.units.length ? <ol class="unit-list">{chapter.units.map((unit: any) => <li>{published.has(unit.id) ? <a class="unit-row available" href={sitePath(`checklists/${unit.id}/`)}><span class="unit-code">{unit.label}</span><span class="unit-title">{unit.title}{unit.part && <span class="part-label">Part {unit.part}</span>}{unit.detail && <small>{unit.detail}</small>}</span><span class="unit-status">Open checklist <span aria-hidden="true">↗</span></span></a> : <div class="unit-row locked"><span class="unit-code">{unit.label}</span><span class="unit-title">{unit.title}{unit.part && <span class="part-label">Part {unit.part}</span>}{unit.detail && <small>{unit.detail}</small>}</span><span class="unit-status"><Lock /><span>Not yet available</span></span></div>}</li>)}</ol> : <div class="chapter-placeholder">{published.has(chapter.id) ? <a class="text-link" href={sitePath(`checklists/${chapter.id}/`)}>Open checklist ↗</a> : <span class="locked-legend"><Lock /> Not yet available</span>}</div>}
          </section>)}
        </section>)}
      </div>
    </div>
  </main>
</Base>
